# Supabase project (service key stays on the Python API and worker)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Frontend build environment: public credentials only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only proxy destination
BACKEND_URL=http://127.0.0.1:8000

# Model providers: at least one primary provider is required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional providers require both a key and an explicit model ID
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# local: sentence-transformers; hash: explicit offline development mode
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
STAGE1_MIN_SIMILARITY=0.55
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
DISCOVERY_INTERVAL_HOURS=4
GREENHOUSE_COMPANIES=stripe,airbnb,anthropic,vercel,supabase,linear,retool
LEVER_COMPANIES=palantir,plaid,mistral
ASHBY_COMPANIES=ramp,notion,perplexity,elevenlabs
WORKER_AUTO_APPLY_ENABLED=false
WORKER_SCHEDULE_ENABLED=false
