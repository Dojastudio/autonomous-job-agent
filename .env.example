# ==============================================================================
# Autonomous Job Finder & Auto-Apply AI Agent — Environment Configuration
# ==============================================================================

# --- 1. SUPABASE (Database, Auth, pgvector, Storage) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key

# Next.js Public Env Vars (Mirror of Supabase URL & Anon Key + Backend API URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- 2. MULTI-MODEL FREE-TIER AI ROUTER KEYS ---
# Primary High-Context Parser & Job Scorer (gemini-3.5-flash-lite / gemini-3.8-flash)
GEMINI_API_KEY=your-google-ai-studio-api-key

# Primary Low-Latency Form Mapper & Screening Q&A (openai/gpt-oss-120b / qwen/qwen3.8-27b)
GROQ_API_KEY=gsk_your-groq-api-key

# Fallback Free-Tier Providers
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
CEREBRAS_API_KEY=csk-your-cerebras-api-key

# --- 3. EMBEDDINGS & VECTOR CONFIGURATION ---
# Options: "local" (sentence-transformers/all-MiniLM-L6-v2) or "gemini" (text-embedding-004 truncated/scaled to 384d)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- 4. WORKER & PLAYWRIGHT ENGINE SETTINGS ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
DISCOVERY_INTERVAL_HOURS=4
STAGE1_MIN_SIMILARITY=0.55

# Comma-separated default company slugs for public ATS feed polling
GREENHOUSE_COMPANIES=stripe,airbnb,anthropic,scaleai,vercel,supabase,linear,retool
LEVER_COMPANIES=netflix,palantir,plaid,figma,mistral
ASHBY_COMPANIES=openai,ramp,notion,perplexity,elevenlabs
